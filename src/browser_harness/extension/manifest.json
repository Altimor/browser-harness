{
  "manifest_version": 3,
  "name": "Browser Use",
  "version": "1.0.0",
  "description": "Connect AI agents to the browser you already use. Automate, scrape and test the web in your own logged-in session.",
  "homepage_url": "https://browser-use.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "tabGroups", "alarms"],
  "background": { "service_worker": "sw.js" }
}
